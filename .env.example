# ClearDraft local configuration. Copy to .env and fill in only the provider
# credential needed for an explicitly selected live mode.
PROCESSING_MODE=local_rules
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# DeepSeek is the optional live provider used by the current adapter.
DEEPSEEK_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DATABASE_URL=sqlite:///./var/cleardraft.db
STORAGE_ROOT=./var/storage
OCR_LANGUAGES=eng
OCR_TIMEOUT_SECONDS=30
PROVIDER_TIMEOUT_SECONDS=60
WORKER_CONCURRENCY=1
RUN_MAX_ATTEMPTS=2
RUN_BUDGET_USD=
PARTICIPANT_ROOT=./sdoc-hackathon-bundle
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173
VITE_API_URL=/api/v1
