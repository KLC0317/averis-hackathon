{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClearDraft strict organizer submission",
  "description": "Shape and cross-field consistency. The application must additionally require exactly the original email IDs of the selected import.",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "type": "string",
    "minLength": 1
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "category",
      "status",
      "review_reason",
      "has_defect",
      "defect_fields"
    ],
    "properties": {
      "category": {
        "type": "string",
        "enum": [
          "BL_COMPARISON",
          "SI_REQUEST",
          "INVOICE_QUERY",
          "GENERAL",
          "SPAM"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "OK",
          "MISMATCH",
          "NEEDS_REVIEW"
        ]
      },
      "review_reason": {
        "enum": [
          null,
          "wrong_doc_type",
          "missing_attachment",
          "unreadable",
          "missing_value"
        ]
      },
      "has_defect": {
        "type": "boolean"
      },
      "defect_fields": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "shipper",
            "consignee",
            "notify_party",
            "port_of_loading",
            "port_of_discharge",
            "container_count",
            "gross_weight_kg"
          ]
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "OK"
            }
          }
        },
        "then": {
          "properties": {
            "review_reason": {
              "type": "null"
            },
            "has_defect": {
              "const": false
            },
            "defect_fields": {
              "maxItems": 0
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "MISMATCH"
            }
          }
        },
        "then": {
          "properties": {
            "category": {
              "const": "BL_COMPARISON"
            },
            "review_reason": {
              "type": "null"
            },
            "has_defect": {
              "const": true
            },
            "defect_fields": {
              "minItems": 1
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "NEEDS_REVIEW"
            }
          }
        },
        "then": {
          "properties": {
            "category": {
              "const": "BL_COMPARISON"
            },
            "review_reason": {
              "enum": [
                "wrong_doc_type",
                "missing_attachment",
                "unreadable",
                "missing_value"
              ]
            },
            "has_defect": {
              "const": false
            },
            "defect_fields": {
              "maxItems": 0
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "category": {
              "enum": [
                "SI_REQUEST",
                "INVOICE_QUERY",
                "GENERAL",
                "SPAM"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "status": {
              "const": "OK"
            }
          }
        }
      }
    ]
  }
}
